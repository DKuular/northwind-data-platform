# ============================================
# Northwind Data Platform - Environment Variables
# ============================================
# Copy this file to .env and fill with real values
# .env is ignored by git

# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=northwind

# Roles for services
DEBEZIUM_PASSWORD=CHANGE_ME
AIRFLOW_PASSWORD=CHANGE_ME
SPARK_READER_PASSWORD=CHANGE_ME
BI_READER_PASSWORD=CHANGE_ME
SODA_PASSWORD=CHANGE_ME
MONITOR_PASSWORD=CHANGE_ME

# ===== Kafka =====
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MINIO_BUCKET=iceberg-warehouse

# ===== Spark =====
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077

# ===== Monitoring =====
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ===== OpenMetadata =====
OPENMETADATA_PASSWORD=CHANGE_ME

# ===== MLflow =====
MLFLOW_TRACKING_PASSWORD=CHANGE_ME