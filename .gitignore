.env
.env.local
.env.example
.env.*.local
*.pem
*.key
*.crt

# Binary artifacts
*.jar

# Data directories
data/
postgres_data/
minio_data/
prometheus_data/
grafana_data/
openmetadata_data/
elasticsearch_data/

# Logs
logs/
*.log
*.out
*.err
server-01-oltp/logs/*
servers/server-01-oltp/dags/__pycache__/*

# Spark artifacts
spark-warehouse/
metastore_db/
derby.log
checkpoints/
*.checkpoint/

# ML artifacts
mlruns/
mlflow.db
*.pkl
*.joblib
*.model

# Feast
feature_store.yaml.local
*.pb

# Docker artifacts
*.tar
*.gz
*.zip

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.venv/

# Terraform
*.tfstate
*.tfstate.*
.terraform/

# Ansible
*.retry

# Other
docker_commands.txt
docker_commands.md

# Conversations
conversations/